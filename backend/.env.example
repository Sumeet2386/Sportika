# ==============================================================================
# Sportika Backend Environment Variables
# Copy this file to .env and replace placeholders with your actual configuration.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS / Frontend Client URL
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or local DB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sportika_db

# JWT Authentication
# IMPORTANT: In production, JWT_SECRET must be a unique, cryptographically strong random string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Bootstrap Admin Credentials
# If set on startup, an admin account with these credentials will be bootstrapped if not present
ADMIN_EMAIL=admin@sportika.in
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Sportika Admin

# SMTP Email Configuration (Nodemailer - for verification OTP & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
